# UpPromote
UPPROMOTE_URL=https://af.uppromote.com/hypdshop/dashboard
UPPROMOTE_EMAIL=
UPPROMOTE_PASSWORD=
SCRAPER_HEADLESS=true
PLAYWRIGHT_STORAGE_STATE_PATH=./playwright-session/storage-state.json

# Commission calculation override. Example: 0.07 for 7%.
# Leave blank to use the amount shown by UpPromote.
COMMISSION_RATE=

# Google Sheets
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=RAW_ORDERS
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Sync behavior
SCRAPE_MODE=full
