# Recommended multi-account configuration.
# JSON should be base64 encoded and stored in UPPROMOTE_ACCOUNTS_JSON_B64.
# Each account supports: id, name, url, email, password, storageStatePath,
# optional storageStateB64, commissionRate, and allowEmptyFullSync.
UPPROMOTE_ACCOUNTS_JSON_B64=

# Backward-compatible single-account mode (used when UPPROMOTE_ACCOUNTS_JSON_B64 is empty)
UPPROMOTE_URL=https://af.uppromote.com/hypdshop/dashboard
UPPROMOTE_EMAIL=
UPPROMOTE_PASSWORD=
PLAYWRIGHT_STORAGE_STATE_PATH=./playwright-session/storage-state.json

SCRAPER_HEADLESS=true
COMMISSION_RATE=

# Google Sheets via Google Apps Script Web App
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
GOOGLE_APPS_SCRIPT_CHUNK_SIZE=500
GOOGLE_SHEETS_TAB=RAW_ORDERS

# Sync behavior
# full = replace each account's data after a proven complete pagination pass
# snapshot = upsert only the currently visible rows
SCRAPE_MODE=full
FAIL_WORKFLOW_ON_ANY_ACCOUNT_ERROR=true
